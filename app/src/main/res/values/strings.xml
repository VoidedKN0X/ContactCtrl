    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening ContactCtrl</string>
    <string name="app_lock_footer">ContactCtrl works fully offline: it has no internet permission, analytics or tracking. Your contacts stay in your phone\'s own contacts storage and in the accounts you chose.</string>
    <string name="lock_prompt_subtitle">Your contacts</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. ContactCtrl will reset its own settings and turn the app lock off. Your contacts are not deleted. If your phone has a screen lock, you\'ll confirm with it first.</string>
